<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Safety Project</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
  <link rel="stylesheet" href="styles/main.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <style>
    table {
      border-collapse: collapse;
    }

    th,
    td {

      border: 1px solid black;
    }
  </style>
</head>

<body>
  <div class="main_div_container">
    <div class="container">
          <header class="d-flex flex-wrap align-items-center justify-content-between py-3 mb-4 border-bottom">
      <div class="d-flex align-items-center col-md-3">
        <img src="https://cdn.phototourl.com/free/2026-09-06-ad0face6-3c71-4fbe-9d08-068d13ff7b58.png" class="img-fluid ms-2" alt="Scout Logo" width="150" height="auto" loading="lazy">
      </div>

      <ul class="nav col-12 col-md-auto mb-2 justify-content-center mb-md-0">
        <li class="nav-item"><a href="/" class="nav-link px-3 link-secondary">Home</a></li>
        <li class="nav-item"><a href="/leaderboard" class="nav-link px-3">Leaderboard</a></li>
        <li class="nav-item"><a href="/report" class="nav-link px-3">Report</a></li>
        <li class="nav-item"><a href="/maps" class="nav-link px-3">Incidents Nearby</a></li>
      </ul>

      <div class="col-12 col-md-3 text-end">
        <% if (!isLoggedIn) { %>
          <a href="/signin" class="btn btn-primary me-2">Login</a>
          <a href="/signup" class="btn btn-outline-primary">Sign-up</a>
        <% } else { %>
          <div id="login_holder" class="d-inline-block">
            <h5 class="mb-0"><%=currentUser%></h5>
          </div>
        <% } %>
      </div>
    </header>

    </div>


</html>